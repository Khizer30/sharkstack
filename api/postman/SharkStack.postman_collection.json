    {
      "name": "Chatbot",
      "item": [
        {
          "name": "Send Message (New Session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "",
                  "if (data && data.data && data.data.sessionId) {",
                  "    pm.collectionVariables.set(\"sessionID\", data.data.sessionId);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"message\": \"How many leads do we have right now?\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/chatbot/chat",
              "host": [
                "{{url}}"
              ],
              "path": [
                "chatbot",
                "chat"
              ]
            },
            "description": "Sends the first message of a new conversation. Omit `sessionId` to start a fresh session — the response includes a `sessionId` to reuse on every following message so the bot keeps short-term memory of this conversation."
          },
          "response": []
        },
        {
          "name": "Send Message (Continue Session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "",
                  "if (data && data.data && data.data.sessionId) {",
                  "    pm.collectionVariables.set(\"sessionID\", data.data.sessionId);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"message\": \"Can you list the most recent ones?\",\r\n    \"sessionId\": \"{{sessionID}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/chatbot/chat",
              "host": [
                "{{url}}"
              ],
              "path": [
                "chatbot",
                "chat"
              ]
            },
            "description": "Continues the conversation started by 'Send Message (New Session)' by passing the saved `sessionId` collection variable, so the bot remembers earlier turns (e.g. it should resolve 'them'/'it' from context)."
          },
          "response": []
        },
