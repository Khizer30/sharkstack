{
  "name": "api",
  "scripts": {
    "db:studio": "pnpm drizzle-kit studio",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:push": "pnpm drizzle-kit push",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/projects.seed.ts",
    "db:seed:packages": "ts-node -r tsconfig-paths/register scripts/packages.seed.ts",
    "db:seed:team": "ts-node -r tsconfig-paths/register scripts/teamMembers.seed.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "debug": "nest start --debug --watch",
    "dev": "nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/src/main"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@getbrevo/brevo": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@paralleldrive/cuid2": "^3.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
